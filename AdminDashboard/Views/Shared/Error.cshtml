@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ";
}

<div class="surface-card courses-empty">
    <span><i class="fas fa-triangle-exclamation"></i></span>
    <h1>تعذر إكمال الطلب</h1>
    <p>حدث خطأ غير متوقع. حاول مرة أخرى، وإذا استمرت المشكلة تواصل مع مسؤول النظام.</p>
    @if (Model.ShowRequestId)
    {<small>رقم التتبع: <code>@Model.RequestId</code></small>}
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">العودة للرئيسية</a>
</div>
