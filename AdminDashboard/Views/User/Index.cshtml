@model IEnumerable<UserViewModel>
@inject Microsoft.Extensions.Options.IOptions<AdminDashboard.Helpers.AdminSettings> AdminSettings
@{
    ViewData["Title"] = "إدارة المستخدمين";
    var isPrimaryAdmin = string.Equals(
        User.FindFirstValue(System.Security.Claims.ClaimTypes.Email),
        AdminSettings.Value.PrimaryAdminEmail,
        StringComparison.OrdinalIgnoreCase);
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="dashboard-title">إدارة المستخدمين</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">الرئيسية</a></li>
                        <li class="breadcrumb-item active">المستخدمون</li>
                    </ol>
                </nav>
            </div>
            @if (isPrimaryAdmin)
            {
            <div class="action-buttons">
                <a class="btn btn-custom" asp-action="AddAdmin" asp-controller="Admin">
                    <i class="fas fa-user-plus"></i> إضافة مسؤول
                </a>
            </div>
            }
        </div>
    </div>

    <div class="search-filter-container mb-4">
        <div class="row">
            <div class="col-md-4">
                <div class="search-box">
                    <input type="text" id="searchUsers" class="form-control" placeholder="ابحث عن مستخدم...">
                    <i class="fas fa-search search-icon"></i>
                </div>
            </div>
            <div class="col-md-8">
                <div class="filters d-flex gap-2 justify-content-end">
                    <select class="form-select w-auto" id="roleFilter">
                        <option value="">كل الأدوار</option>
                        <option value="Admin">مسؤول</option>
                        <option value="User">مستخدم</option>
                    </select>
                    <select class="form-select w-auto" id="statusFilter">
                        <option value="">كل الحالات</option>
                        <option value="active">نشط</option>
                        <option value="deleted">محذوف</option>
                    </select>
                    <select class="form-select w-auto" id="confirmedFilter">
                        <option value="">حالة تأكيد البريد</option>
                        <option value="true">مؤكد</option>
                        <option value="false">غير مؤكد</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="custom-thead">
                            <tr>
                                <th class="text-center">#</th>
                                <th>اسم المستخدم</th>
                                <th>الاسم المعروض</th>
                                <th>البريد الإلكتروني</th>
                                <th class="text-center">الحالة</th>
                                <th class="text-center">تأكيد البريد</th>
                                <th class="text-center">الأدوار</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @foreach (var user in Model)
                            {
                                <tr data-user-row
                                    data-roles="@string.Join(" ", user.Roles).ToLowerInvariant()"
                                    data-status="@(user.IsDeleted ? "deleted" : "active")"
                                    data-confirmed="@user.IsConfirmed.ToString().ToLowerInvariant()">
                                    <td class="text-center">@(rowNumber++)</td>
                                    <td>
                                        <span>@user.UserName</span>
                                    </td>
                                    <td>@user.DisplayName</td>
                                    <td>@user.Email</td>
                                    <td class="text-center">
                                        <span class="status-badge @(user.IsDeleted ? "status-deleted" : "status-active")">
                                            @(user.IsDeleted ? "محذوف" : "نشط")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="status-badge @(user.IsConfirmed ? "status-confirmed" : "status-unconfirmed")">
                                            @(user.IsConfirmed ? "مؤكد" : "غير مؤكد")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="role-badge">@role</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="action-buttons">
                                            @{
                                                var isAdmin = user.Roles.Contains("Admin");
                                            }
                                            <button class="btn btn-icon @(isAdmin || !isPrimaryAdmin ? "disabled" : "")"
                                                    onclick="editUser('@user.Id')"
                                                    title="تعديل"
                                            @(isAdmin || !isPrimaryAdmin ? "disabled" : "")>
                                                <i class="fas fa-pen"></i>
                                            </button>
                                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المستخدم؟');">
                                                <button type="submit" class="btn btn-icon @(isAdmin ? "disabled" : "")" title="حذف" @(isAdmin ? "disabled" : "")>
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="compact-empty py-5">
                    <i class="fas fa-users"></i>
                    <h2>لا يوجد مستخدمون</h2>
                    <p>لا توجد حسابات مطابقة لمعايير البحث.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchUsers');
            const roleFilter = document.getElementById('roleFilter');
            const statusFilter = document.getElementById('statusFilter');
            const confirmedFilter = document.getElementById('confirmedFilter');

            function applyFilters() {
                const searchTerm = searchInput.value.trim().toLocaleLowerCase('ar');
                const selectedRole = roleFilter.value.toLowerCase();
                const selectedStatus = statusFilter.value.toLowerCase();
                const selectedConfirmed = confirmedFilter.value.toLowerCase();
                const rows = document.querySelectorAll('[data-user-row]');

                rows.forEach(row => {
                    const searchMatch = !searchTerm || row.textContent.toLocaleLowerCase('ar').includes(searchTerm);
                    const roleMatch = !selectedRole || row.dataset.roles.includes(selectedRole);
                    const statusMatch = !selectedStatus || row.dataset.status === selectedStatus;
                    const confirmedMatch = !selectedConfirmed || row.dataset.confirmed === selectedConfirmed;

                    row.hidden = !(searchMatch && roleMatch && statusMatch && confirmedMatch);
                });
            }

            searchInput.addEventListener('input', applyFilters);
            roleFilter.addEventListener('change', applyFilters);
            statusFilter.addEventListener('change', applyFilters);
            confirmedFilter.addEventListener('change', applyFilters);
        });

        function editUser(userId) {
            window.location.href = `/User/Edit/${userId}`;
        }

    </script>
}
