@model CourseIndexViewModel
@{
    ViewData["Title"] = "الكورسات";
    var firstItem = Model.TotalItems == 0 ? 0 : ((Model.PageNumber - 1) * CourseIndexViewModel.CoursesPerPage) + 1;
    var lastItem = Math.Min(Model.PageNumber * CourseIndexViewModel.CoursesPerPage, Model.TotalItems);
    var firstVisiblePage = Math.Max(1, Model.PageNumber - 2);
    var lastVisiblePage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

<section class="page-heading courses-page-heading">
    <div><span class="eyebrow">المحتوى التعليمي</span><h1>إدارة الكورسات</h1><p>راجع محتوى المنصة وعدّله أو أضف كورساً جديداً.</p></div>
    <a asp-action="Create" asp-controller="Course" class="btn btn-primary"><i class="fas fa-plus ms-2"></i>إضافة كورس جديد</a>
</section>

<section class="course-summary" aria-label="ملخص الكورسات">
    <div><span class="summary-icon"><i class="fas fa-book-open"></i></span><p><strong>@Model.TotalCourses.ToString("N0")</strong><small>إجمالي الكورسات</small></p></div>
    <div><span class="summary-icon"><i class="fas fa-circle-play"></i></span><p><strong>@Model.TotalVideos.ToString("N0")</strong><small>إجمالي الفيديوهات</small></p></div>
    <div><span class="summary-icon"><i class="fas fa-star"></i></span><p><strong>@Model.AverageRating.ToString("0.0")</strong><small>متوسط التقييم</small></p></div>
</section>

<form asp-action="Index" method="get" class="courses-toolbar surface-card" aria-label="البحث والتصفية">
    <div class="course-search">
        <i class="fas fa-search"></i>
        <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="ابحث باسم الكورس أو المؤلف..." aria-label="البحث في الكورسات">
    </div>
    <select name="language" class="form-select" aria-label="تصفية حسب اللغة">
        <option value="">كل اللغات</option>
        @foreach (var language in Model.Languages)
        {
            <option value="@language" selected="@(Model.Language == language ? "selected" : null)">@language</option>
        }
    </select>
    <select name="category" class="form-select" aria-label="تصفية حسب التصنيف">
        <option value="">كل التصنيفات</option>
        @foreach (var category in Model.Categories)
        {
            <option value="@category" selected="@(Model.Category == category ? "selected" : null)">@category</option>
        }
    </select>
    <select name="minimumRating" class="form-select" aria-label="تصفية حسب التقييم">
        <option value="">كل التقييمات</option>
        <option value="4" selected="@(Model.MinimumRating == 4 ? "selected" : null)">4 نجوم فأكثر</option>
        <option value="3" selected="@(Model.MinimumRating == 3 ? "selected" : null)">3 نجوم فأكثر</option>
        <option value="2" selected="@(Model.MinimumRating == 2 ? "selected" : null)">نجمتان فأكثر</option>
    </select>
    <div class="course-filter-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-filter ms-2"></i>تطبيق</button>
        <a asp-action="Index" class="btn btn-secondary" aria-label="إعادة ضبط عوامل التصفية"><i class="fas fa-rotate-right"></i></a>
    </div>
</form>

@if (Model.Courses.Count > 0)
{
    <section class="courses-card-grid" aria-live="polite">
        @foreach (var course in Model.Courses)
        {
            var categoryName = course.Category?.Name ?? "غير مصنف";
            <article class="course-management-card">
                <div class="course-card-media">
                    @if (!string.IsNullOrWhiteSpace(course.Image))
                    {
                        <img src="@Url.Content(course.Image)" alt="صورة كورس @course.Name" loading="lazy" />
                    }
                    else
                    {
                        <div class="course-image-placeholder"><i class="fas fa-book-quran"></i><span>زاد العلم</span></div>
                    }
                    <span class="course-category-badge">@categoryName</span>
                    <span class="course-id-badge">#@course.Id</span>
                </div>
                <div class="course-card-content">
                    <div class="course-card-title-row">
                        <div><h2>@course.Name</h2><p><i class="fas fa-chalkboard-user"></i> @course.Author</p></div>
                        <span class="course-rating"><i class="fas fa-star"></i>@course.rating.ToString("0.0")</span>
                    </div>
                    <p class="course-card-description">@course.Description</p>
                    <div class="course-meta-row">
                        <span><i class="fas fa-language"></i>@course.CourseLanguage</span>
                        <span><i class="fas fa-circle-play"></i>@course.CourseVideosCount فيديو</span>
                        <span><i class="far fa-calendar"></i>@course.CreatedAt.ToString("yyyy/MM/dd")</span>
                    </div>
                </div>
                <div class="course-card-actions">
                    <a asp-action="Edit" asp-route-id="@course.Id" class="btn course-edit-button"><i class="fas fa-pen ms-2"></i>تعديل الكورس</a>
                    <a asp-action="Delete" asp-route-id="@course.Id" class="btn course-delete-button" onclick="return confirm('هل أنت متأكد من حذف هذا الكورس؟');" aria-label="حذف كورس @course.Name"><i class="fas fa-trash"></i></a>
                </div>
            </article>
        }
    </section>

    <div class="courses-pagination surface-card">
        <p>عرض @firstItem–@lastItem من @Model.TotalItems كورس</p>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="صفحات الكورسات">
                <ul class="pagination mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@Model.Search" asp-route-language="@Model.Language" asp-route-category="@Model.Category" asp-route-minimumRating="@Model.MinimumRating" aria-label="الصفحة السابقة"><i class="fas fa-chevron-right"></i></a>
                    </li>
                    @if (firstVisiblePage > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1" asp-route-search="@Model.Search" asp-route-language="@Model.Language" asp-route-category="@Model.Category" asp-route-minimumRating="@Model.MinimumRating">1</a></li>
                        @if (firstVisiblePage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }
                    @for (var pageItem = firstVisiblePage; pageItem <= lastVisiblePage; pageItem++)
                    {
                        <li class="page-item @(pageItem == Model.PageNumber ? "active" : null)">
                            <a class="page-link" asp-action="Index" asp-route-page="@pageItem" asp-route-search="@Model.Search" asp-route-language="@Model.Language" asp-route-category="@Model.Category" asp-route-minimumRating="@Model.MinimumRating" aria-current="@(pageItem == Model.PageNumber ? "page" : null)">@pageItem</a>
                        </li>
                    }
                    @if (lastVisiblePage < Model.TotalPages)
                    {
                        @if (lastVisiblePage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-search="@Model.Search" asp-route-language="@Model.Language" asp-route-category="@Model.Category" asp-route-minimumRating="@Model.MinimumRating">@Model.TotalPages</a></li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : null)">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@Model.Search" asp-route-language="@Model.Language" asp-route-category="@Model.Category" asp-route-minimumRating="@Model.MinimumRating" aria-label="الصفحة التالية"><i class="fas fa-chevron-left"></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
else
{
    <div class="courses-empty surface-card">
        <span><i class="fas fa-magnifying-glass"></i></span><h2>@(Model.TotalCourses == 0 ? "لا توجد كورسات بعد" : "لا توجد نتائج مطابقة")</h2><p>@(Model.TotalCourses == 0 ? "ابدأ بإضافة أول كورس إلى المنصة." : "جرّب تغيير كلمة البحث أو عوامل التصفية.")</p>
        @if (Model.TotalCourses == 0)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus ms-2"></i>إضافة أول كورس</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">مسح عوامل التصفية</a>
        }
    </div>
}
